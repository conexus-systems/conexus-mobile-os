# Conexus Mobile OS - udev rules for device access
# Install with: sudo cp 51-conexus-mobile.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger

# Google Pixel 8a (akita)
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4eed", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4eee", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4ef0", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# Nothing Phone (2) (pong)
SUBSYSTEM=="usb", ATTR{idVendor}=="2a70", ATTR{idProduct}=="4eee", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2a70", ATTR{idProduct}=="4ef0", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# Generic Google devices (for fastboot/adb)
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# Generic Nothing devices
SUBSYSTEM=="usb", ATTR{idVendor}=="2a70", MODE="0666", GROUP="plugdev", TAG+="uaccess"

